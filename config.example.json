{
  "listen": ":7863",
  "api_key": "test_key",
  "auth_dir": "./auths",
  "state_file": "./data/state.json",
  "dns_servers": [],
  "server": {
    "read_timeout": "300s"
  },
  "panel": {
    "package_detail_limit": 5
  },
  "logging": {
    "request_archive_enabled": true,
    "request_retention_days": 7,
    "request_archive_max_mb": 100,
    "request_client_info": true
  },
  "cooldown": {
    "soft_rate": "600s",
    "soft_rate_max": "2h"
  },
  "schedule": {
    "checkin_hours": [9, 21],
    "travel_hours": [9, 21],
    "activity_hours": [10],
    "keepalive_hours": [22],
    "blackcat_hours": [23],
    "growth_hours": [11],
    "checkin_enabled": true,
    "travel_enabled": true,
    "activity_enabled": true,
    "keepalive_enabled": true,
    "blackcat_enabled": true,
    "growth_enabled": true,
    "growth_concurrency": 1,
    "jitter_minutes": 0,
    "balance_refresh_enabled": true,
    "balance_refresh_minutes": 5,
    "include_disabled_in_tasks": false
  },
  "global": {
    "enabled": true,
    "chat_base": "",
    "billing_base": ""
  },
  "cn": {
    "chat_base": ""
  },
  "upstream": {
    "timeout_seconds": 120,
    "header_timeout_seconds": 120,
    "idle_timeout_seconds": 300,
    "user_agent": "",
    "client_version": "",
    "cli_version": "",
    "client_name": "",
    "device_token": "",
    "device_token_file": "",
    "passthrough_ip": false
  },
  "features": {
    "sanitize_blacklist_fingerprints": true
  },
  "models": {
    "_comment": "hidden: 不对外暴露的模型黑名单。裸名=两域都藏；\"cn:xxx\"/\"global:xxx\"=只藏该域。/v1/models 列表过滤 + chat 点名拒绝，面板保存后热生效。",
    "hidden": []
  },
  "thinking": {
    "_comment": "网关档位策略：客户端没带 reasoning_effort 时按 default_effort 补齐（max = 该模型声明档位里的最高档）；client_priority=true 客户端显式档位优先，false 网关优先；override_scope=level 只覆盖档位、尊重客户端 thinking.type=disabled，all 连开关一起覆盖。默认启用、max、客户端优先、level；保存即热生效。",
    "enabled": true,
    "default_effort": "max",
    "client_priority": true,
    "override_scope": "level",
    "model_defaults": {}
  },
  "prompt": {
    "mode": "passthrough",
    "file": ""
  },
  "upstash": {
    "url": "",
    "token": ""
  },
  "pool": {
    "max_in_flight": 3,
    "max_in_flight_global": 2,
    "breaker_threshold": 3,
    "breaker_cooldown": "30m",
    "breaker_cooldown_max": "6h",
    "degrade_threshold": 5,
    "degrade_cooldown": "10m",
    "degrade_cooldown_max": "2h",
    "idle_weight_per_hour": 0.5,
    "idle_weight_max": 5.0,
    "prefer_expiring": true,
    "expiring_soon": "168h",
    "account_priority": {},
    "account_share": {},
    "cost_explore_interval": "30m",
    "credit_floor": 100,
    "reserve_credits": 10
  },
  "session_sticky": {
    "enabled": true,
    "ttl": "30m",
    "gc_interval": "5m"
  },
  "admin": {
    "enabled": false,
    "audit_enabled": false,
    "audit_file": "./data/admin_audit.log"
  },
  "metrics": { "enabled": false },
  "budget": { "daily_credit_limit": 0, "burst_credit_limit": 0, "cache_low_rate": 0 },
  "alerting": {
    "enabled": false,
    "webhook_url": "",
    "min_healthy_cn": 1,
    "min_healthy_global": 0
  }
}
